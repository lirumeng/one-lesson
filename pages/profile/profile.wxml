<view class="profile-page {{user.loggedIn ? '' : 'login-page'}}">
  <view wx:if="{{user.loggedIn}}" class="user-card">
    <image wx:if="{{user.avatarUrl}}" class="avatar" src="{{user.avatarUrl}}" mode="aspectFill"></image>
    <view wx:else class="avatar avatar-letter">{{user.initial}}</view>
    <view class="user-info"><view class="user-name">{{user.nickName}}</view><view class="login-state">记录每一次认真学习的时刻</view></view>
    <view class="logout" bindtap="logout">退出</view>
  </view>
  <view wx:else class="onboarding-card">
    <view class="login-brand"><view class="onboarding-mark">一</view><view><view class="onboarding-title">欢迎使用一课时</view><view class="onboarding-text">记录每一次认真学习的时刻</view></view></view>
    <view class="login-divider"></view>
    <button class="authorize-button" style="margin-top:32rpx;" bindtap="completeLogin" loading="{{loginPending}}" disabled="{{loginPending}}">{{loginPending ? '正在登录' : '微信登录'}}</button>
  </view>

  <view wx:if="{{user.loggedIn}}" class="logged-content">
  <view class="stats-title" style="margin-top:30rpx;">学习档案</view>
  <view class="stats-grid">
    <view class="archive-stat"><text>{{stats.totalUsed}}</text><small>累计消课时</small></view>
    <view class="archive-stat"><text>{{stats.courseCount}}</text><small>记录课程</small></view>
    <view class="archive-stat"><text>{{stats.monthUsed}}</text><small>本月消课</small></view>
  </view>

  <view class="report-head"><view class="stats-title">月度学习报表</view><text>近 6 个月</text></view>
  <view class="report-card">
    <view class="report-total"><text>{{stats.monthUsed}}</text><small>本月已消课时</small></view>
    <view class="chart">
      <view wx:for="{{report}}" wx:key="key" class="chart-column">
        <text wx:if="{{item.count}}" class="bar-value">{{item.count}}</text>
        <view class="bar-zone"><view class="bar {{item.current ? 'bar-current' : ''}}" style="height: {{item.height}}rpx;"></view></view>
        <text class="bar-label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{reminders.length}}" class="reminder-head profile-reminder-head"><view class="stats-title">课程到期提醒</view><text>{{reminders.length}} 门需关注</text></view>
  <view wx:if="{{reminders.length}}" class="profile-reminders">
    <view wx:for="{{reminders}}" wx:key="id" class="profile-reminder"><view><text class="reminder-dot" style="background: {{item.color}};"></text>{{item.name}}</view><text class="{{item.isExpired ? 'expired' : ''}}">{{item.dueText}}</text></view>
  </view>

  <view class="record-head"><view class="stats-title">最近消课记录</view><text wx:if="{{hasMoreRecords}}" bindtap="openAllRecords">查看全部</text><text wx:elif="{{records.length}}">共 {{records.length}} 条</text></view>
  <view wx:if="{{records.length}}" class="timeline">
    <view wx:for="{{records}}" wx:key="id" class="timeline-item">
      <view class="timeline-dot" style="background: {{item.color}};"></view>
      <view class="timeline-text"><view>{{item.courseName}}</view><text>完成 1 课时 · {{item.timestamp}}</text></view>
      <view class="record-type" style="color: {{item.color}}; background: {{item.tint}};">{{item.type}}</view>
    </view>
  </view>
  <view wx:else class="record-empty"><view>还没有消课记录</view></view>

  <view class="privacy-note">你的课程和消课记录已加密同步至云端</view>
  </view>
  <view wx:if="{{user.loggedIn}}" class="bottom-nav">
    <view class="nav-item" bindtap="goCourses"><text class="nav-icon">⌂</text><text>课程</text></view>
    <view class="nav-item nav-active"><text class="nav-icon">◉</text><text>我的</text></view>
  </view>
  <view wx:if="{{showAllRecords}}" style="position:fixed;inset:0;z-index:10;background:rgba(18,34,24,.4);display:flex;align-items:flex-end;" bindtap="closeAllRecords">
    <view style="width:100%;max-height:78vh;box-sizing:border-box;padding:22rpx 28rpx 42rpx;background:#fbfcf8;border-radius:32rpx 32rpx 0 0;" catchtap="stopPropagation">
      <view style="width:66rpx;height:8rpx;margin:0 auto 24rpx;border-radius:8rpx;background:#d5ddd2;"></view>
      <view style="display:flex;align-items:center;justify-content:space-between;margin-bottom:18rpx;"><text style="font-size:34rpx;font-weight:700;">全部消课记录</text><text style="padding:10rpx;color:#718071;font-size:34rpx;" bindtap="closeAllRecords">×</text></view>
      <scroll-view wx:if="{{recordCourses.length}}" scroll-x style="white-space:nowrap;margin:0 -4rpx 16rpx;" show-scrollbar="false"><view style="display:inline-flex;gap:14rpx;padding:2rpx 4rpx;"><view class="record-filter {{recordCourseFilter === 'all' ? 'record-filter-active' : ''}}" data-course="all" bindtap="changeRecordCourse">全部</view><view wx:for="{{recordCourses}}" wx:key="*this" class="record-filter {{recordCourseFilter === item ? 'record-filter-active' : ''}}" data-course="{{item}}" bindtap="changeRecordCourse">{{item}}</view></view></scroll-view>
      <scroll-view scroll-y style="max-height:60vh;"><view wx:for="{{filteredRecords}}" wx:key="id" style="display:flex;align-items:center;padding:24rpx 4rpx;border-bottom:1rpx solid #e7ece4;"><view style="box-sizing:content-box;width:16rpx;height:16rpx;margin-right:20rpx;border:5rpx solid #fff;border-radius:50%;box-shadow:0 0 0 2rpx #e7ece4;background:{{item.color}};"></view><view style="flex:1;font-size:28rpx;">{{item.courseName}}<text style="display:block;margin-top:7rpx;color:#859184;font-size:23rpx;">完成 1 课时 · {{item.timestamp}}</text></view><text style="padding:6rpx 12rpx;border-radius:8rpx;color:{{item.color}};background:{{item.tint}};font-size:22rpx;">{{item.type}}</text></view><view wx:if="{{!filteredRecords.length}}" style="padding:60rpx 0;text-align:center;color:#95a095;font-size:24rpx;">该课程还没有消课记录</view></scroll-view>
    </view>
  </view>
</view>
