.profile-page { min-height:100vh; box-sizing:border-box; padding:34rpx 28rpx 175rpx; background:#f7f8f2; color:#1d2a20; }.login-page { padding-top:150rpx; padding-bottom:60rpx; }.profile-hero { padding:9rpx 10rpx 32rpx; }.eyebrow { color:#859083; font-size:19rpx; letter-spacing:3rpx; font-weight:700; }.page-title { font-family:Georgia,serif; font-size:66rpx; letter-spacing:3rpx; line-height:1.25; }.page-subtitle { color:#718071; font-size:24rpx; }
.user-card { min-height:136rpx; box-sizing:border-box; border-radius:25rpx; padding:25rpx; display:flex; align-items:center; box-shadow:0 9rpx 23rpx rgba(31,54,36,.06); background:#274d3a; color:#fff; }.avatar { width:84rpx; height:84rpx; flex:none; border-radius:50%; background:#e6b469; }.avatar-letter { display:flex; align-items:center; justify-content:center; font-family:Georgia,serif; font-size:39rpx; color:#fff; }.user-info { flex:1; margin-left:20rpx; }.user-name { font-size:32rpx; font-weight:700; }.login-state { margin-top:7rpx; display:block; color:#c2d1c1; font-size:21rpx; }.login-state text { display:inline-block; width:11rpx; height:11rpx; border-radius:50%; background:#e7b364; margin:0 7rpx 1rpx 0; }.logout { color:#c4d2c4; font-size:22rpx; padding:15rpx 0 15rpx 15rpx; }
.onboarding-card { padding:40rpx 36rpx 34rpx; background:#fff; border-radius:24rpx; box-shadow:0 12rpx 32rpx rgba(31,54,36,.07); }.login-brand { display:flex; align-items:center; }.onboarding-mark { width:76rpx; height:76rpx; line-height:76rpx; margin-right:20rpx; text-align:center; border-radius:20rpx; color:#fff; background:#315d43; font-family:Georgia,serif; font-size:40rpx; }.onboarding-title { color:#223c2d; font-size:32rpx; font-weight:700; }.onboarding-text { margin-top:7rpx; color:#849084; font-size:21rpx; }.login-divider { height:1rpx; margin:34rpx 0 0; background:#edf0e9; }.login-intro { display:flex; align-items:center; padding:31rpx 0 35rpx; }.login-intro-icon { width:52rpx; height:52rpx; line-height:52rpx; margin-right:17rpx; border-radius:50%; background:#e8f0e8; color:#315d43; text-align:center; font-size:29rpx; font-weight:700; }.field-label { color:#526252; font-size:25rpx; font-weight:600; }.field-tip { display:block; margin-top:7rpx; color:#99a398; font-size:19rpx; }.authorize-button { width:100%; height:90rpx; min-height:90rpx; margin:0; padding:0; border-radius:14rpx; background:#315d43; color:#fff; font-size:28rpx; line-height:1; display:flex; align-items:center; justify-content:center; }.agreement { padding:20rpx 8rpx 0; color:#a0aa9e; text-align:center; font-size:18rpx; line-height:1.6; }
.account-panel { background:#fff; border-radius:20rpx; padding:4rpx 23rpx; margin:18rpx 0 42rpx; }.account-panel > view { min-height:84rpx; display:flex; align-items:center; justify-content:space-between; border-bottom:1rpx solid #edf0e9; }.account-panel > view:last-child { border:0; }.account-panel view view { color:#334a39; font-size:25rpx; margin-top:6rpx; }.account-panel view > text { color:#869186; font-size:20rpx; }.phone-button { margin:0; padding:0 17rpx; height:52rpx; line-height:52rpx; font-size:20rpx; border-radius:10rpx; background:#e8f0e8; color:#315d43; }.verified { color:#6e9b74; font-size:20rpx; }
.locked-content { margin-top:42rpx; text-align:center; background:#fff; border-radius:22rpx; padding:59rpx 36rpx; }.locked-icon { color:#c6d3c4; font-size:64rpx; }.locked-title { color:#4f6252; font-size:29rpx; font-weight:700; margin-top:14rpx; }.locked-text { color:#94a094; font-size:22rpx; line-height:1.7; margin-top:11rpx; }
.stats-title { font-size:30rpx; font-weight:700; }.stats-grid { display:flex; margin:18rpx 0 45rpx; background:#fff; border-radius:20rpx; padding:25rpx 5rpx; }.archive-stat { flex:1; text-align:center; border-right:1rpx solid #edf0e9; }.archive-stat:last-child { border:0; }.archive-stat text { display:block; font-family:Georgia,serif; font-size:45rpx; color:#315d43; }.archive-stat small { color:#7d897c; font-size:20rpx; }
.report-head,.reminder-head,.record-head { display:flex; justify-content:space-between; align-items:center; margin-bottom:10rpx; }.report-head text,.reminder-head > text,.record-head > text { color:#8d988b; font-size:21rpx; }.report-card { background:#fff; border-radius:20rpx; padding:21rpx 24rpx 19rpx; margin-bottom:43rpx; }.report-total { display:flex; align-items:baseline; gap:10rpx; }.report-total text { font-family:Georgia,serif; font-size:43rpx; color:#315d43; }.report-total small { color:#829081; font-size:20rpx; }.chart { height:180rpx; display:flex; align-items:flex-end; justify-content:space-between; padding-top:8rpx; }.chart-column { flex:1; height:100%; display:flex; flex-direction:column; align-items:center; justify-content:flex-end; }.bar-zone { height:119rpx; display:flex; align-items:flex-end; }.bar { width:25rpx; min-height:8rpx; border-radius:8rpx 8rpx 3rpx 3rpx; background:#c8d9cb; }.bar-current { background:#315d43; }.bar-value { height:24rpx; color:#54725d; font-size:18rpx; }.bar-label { margin-top:8rpx; color:#8e9a8d; font-size:18rpx; }.profile-reminder-head { margin-top:0; }.profile-reminders { background:#fff8e9; border:1rpx solid #f0dfbd; border-radius:20rpx; padding:4rpx 21rpx; margin-bottom:43rpx; }.profile-reminder { min-height:69rpx; border-bottom:1rpx solid #f2e5ca; display:flex; justify-content:space-between; align-items:center; color:#584831; font-size:24rpx; }.profile-reminder:last-child { border:0; }.profile-reminder > text { color:#a1763e; font-size:20rpx; }.reminder-dot { width:12rpx; height:12rpx; border-radius:50%; display:inline-block; margin-right:12rpx; }.expired { color:#c85f55 !important; }
.timeline { background:#fff; border-radius:20rpx; padding:0 22rpx; }.timeline-item { min-height:93rpx; display:flex; align-items:center; position:relative; border-bottom:1rpx solid #edf0e9; }.timeline-item:last-child { border:0; }.timeline-dot { width:16rpx; height:16rpx; border:5rpx solid #fff; box-shadow:0 0 0 2rpx #e7ece4; border-radius:50%; margin-right:20rpx; }.timeline-text { flex:1; font-size:25rpx; }.timeline-text text { display:block; color:#859184; font-size:19rpx; margin-top:5rpx; }.record-type { font-size:19rpx; border-radius:8rpx; padding:5rpx 10rpx; }.record-empty { text-align:center; background:#fff; border-radius:20rpx; padding:47rpx 20rpx; color:#738072; font-size:26rpx; }.record-empty text { display:block; color:#9ca79b; margin-top:10rpx; font-size:20rpx; }.privacy-note { color:#98a397; text-align:center; font-size:20rpx; margin-top:34rpx; }.bottom-nav { position:fixed; left:0; right:0; bottom:0; height:105rpx; padding-bottom:env(safe-area-inset-bottom); background:rgba(255,255,255,.97); border-top:1rpx solid #edf0e9; display:flex; }.nav-item { flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:3rpx; color:#94a093; font-size:20rpx; }.nav-icon { font-size:31rpx; line-height:31rpx; }.nav-active { color:#315d43; font-weight:700; }
/* 统一字体与辅助文字字号 */
.page-title,.avatar-letter,.onboarding-mark,.archive-stat text,.report-total text { font-family:inherit !important; }
.eyebrow,.page-subtitle,.login-state,.logout,.onboarding-text,.field-tip,.agreement,.archive-stat small,.report-head text,.reminder-head > text,.record-head > text,.report-total small,.bar-value,.bar-label,.profile-reminder > text,.timeline-text text,.record-type,.privacy-note,.nav-item { font-size:24rpx !important; }
