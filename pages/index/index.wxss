.page { padding: 28rpx 28rpx 190rpx; }
.hero { display:flex; justify-content:space-between; align-items:flex-start; padding:20rpx 10rpx 34rpx; }
.eyebrow { color:#859083; font-size:19rpx; letter-spacing:3rpx; font-weight:700; }
.title { font-family: Georgia, serif; font-size:76rpx; letter-spacing:4rpx; line-height:1.2; margin-top:4rpx; }
.subtitle { color:#718071; font-size:25rpx; margin-top:3rpx; }
.date-badge { width:86rpx; height:86rpx; background:#e8eddf; border-radius:50%; display:flex; flex-direction:column; align-items:center; justify-content:center; color:#60705d; font-size:19rpx; }
.date-day { font-family:Georgia,serif; font-size:38rpx; line-height:38rpx; color:#334635; }
.summary-card { background:#234b38; border-radius:28rpx; padding:30rpx; color:#f8f6e9; box-shadow:0 16rpx 32rpx rgba(35,75,56,.12); }
.summary-head { display:flex; justify-content:space-between; align-items:center; }.section-label { color:#bed0b9; font-size:21rpx; }.month-title { font-size:30rpx; margin-top:4rpx; font-weight:600; }.summary-icon { font-size:54rpx; color:#ddbd78; }
.summary-grid { display:flex; align-items:center; margin-top:32rpx; }.summary-item { flex:1; display:flex; flex-wrap:wrap; align-items:baseline; }.summary-number { font-family:Georgia,serif; font-size:52rpx; }.summary-unit { font-size:20rpx; margin-left:5rpx; color:#dfe8d8; }.summary-caption { width:100%; color:#bfd0be; font-size:20rpx; margin-top:5rpx; }.divider { width:1rpx; height:58rpx; background:#54715f; margin:0 15rpx; }
.reminder-card { background:#fff8e9; border:1rpx solid #f0dfbd; border-radius:21rpx; padding:18rpx 24rpx; margin-top:21rpx; }.reminder-head { display:flex; justify-content:space-between; align-items:center; color:#815f2c; font-size:25rpx; font-weight:700; padding:5rpx 0 11rpx; }.reminder-head text:last-child { color:#aa9169; font-size:20rpx; font-weight:400; }.reminder-icon { color:#d39137; font-size:30rpx; vertical-align:-2rpx; }.reminder-item { display:flex; justify-content:space-between; align-items:center; padding:14rpx 0; border-top:1rpx solid #f2e5ca; font-size:23rpx; }.reminder-name { display:flex; align-items:center; font-weight:600; }.reminder-dot { width:12rpx; height:12rpx; border-radius:50%; margin-right:12rpx; }.due-text { color:#a1763e; font-size:20rpx; }.expired { color:#c85f55 !important; }.placeholder { color:#9aa59a; }
.toolbar { padding:46rpx 5rpx 23rpx; }.toolbar-title { font-size:34rpx; font-weight:700; }.toolbar-title text { color:#899587; font-size:24rpx; margin-left:8rpx; }.filter-row { display:flex; gap:16rpx; margin-top:23rpx; }.filter { color:#728071; background:#edf0e9; padding:11rpx 24rpx; border-radius:30rpx; font-size:23rpx; }.filter-active { color:#fff; background:#355d45; }
.course-list { display:flex; flex-direction:column; gap:20rpx; }.course-card { background:#fff; border-radius:22rpx; overflow:hidden; display:flex; box-shadow:0 7rpx 21rpx rgba(31,54,36,.05); }.course-accent { width:10rpx; }.course-main { flex:1; padding:24rpx 25rpx 21rpx; }.course-top,.course-bottom { display:flex; justify-content:space-between; align-items:center; }.course-type,.detail-type { display:inline-block; padding:6rpx 15rpx; border-radius:8rpx; font-size:20rpx; font-weight:600; }.course-more { color:#9aa59a; letter-spacing:2rpx; }.course-name { font-size:32rpx; font-weight:700; margin:16rpx 0 5rpx; }.course-meta { color:#738073; font-size:23rpx; }.progress-track,.detail-progress { height:10rpx; background:#edf0e9; border-radius:20rpx; overflow:hidden; margin:19rpx 0 15rpx; }.progress-value,.detail-progress view { height:100%; border-radius:20rpx; }.course-bottom { color:#829082; font-size:20rpx; }
.empty-state { text-align:center; padding:105rpx 0; color:#8a968a; }.empty-mark { font-size:74rpx; color:#bbc9b8; }.empty-title { color:#526252; font-size:30rpx; margin-top:15rpx; }.empty-text { font-size:23rpx; margin-top:9rpx; }
.fab { position:fixed; right:30rpx; bottom:125rpx; color:#fff; background:#e58e52; border-radius:50rpx; padding:20rpx 27rpx; box-shadow:0 12rpx 22rpx rgba(229,142,82,.3); font-size:34rpx; z-index:3; }.fab text { font-size:24rpx; margin-left:8rpx; vertical-align:3rpx; }
.bottom-nav { position:fixed; left:0; right:0; bottom:0; height:105rpx; padding-bottom:env(safe-area-inset-bottom); background:rgba(255,255,255,.97); border-top:1rpx solid #edf0e9; display:flex; z-index:2; }.nav-item { flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:3rpx; color:#94a093; font-size:20rpx; }.nav-icon { font-size:31rpx; line-height:31rpx; }.nav-active { color:#315d43; font-weight:700; }
.mask { position:fixed; inset:0; background:rgba(18,34,24,.4); display:flex; align-items:flex-end; z-index:5; }.sheet { width:100%; box-sizing:border-box; background:#fbfcf8; border-radius:34rpx 34rpx 0 0; padding:18rpx 34rpx 45rpx; max-height:88vh; overflow-y:auto; }.sheet-handle { height:8rpx; width:66rpx; border-radius:8rpx; background:#d5ddd2; margin:0 auto 27rpx; }.sheet-title { font-size:38rpx; font-weight:700; margin-bottom:30rpx; }.form-item { background:#f0f3ed; border-radius:15rpx; padding:15rpx 20rpx; margin-bottom:18rpx; }.form-item text,.color-picker > text { display:block; color:#768376; font-size:20rpx; }.form-item input,.picker-value { font-size:29rpx; margin-top:5rpx; height:43rpx; line-height:43rpx; }.picker-value { display:flex; justify-content:space-between; }.picker-value text { font-size:34rpx; line-height:35rpx; }.form-row { display:flex; gap:18rpx; }.compact { flex:1; }.color-picker { padding:7rpx 2rpx 30rpx; }.color-options { display:flex; gap:22rpx; margin-top:17rpx; }.color-dot { width:37rpx; height:37rpx; border-radius:50%; border:5rpx solid transparent; box-sizing:content-box; }.color-dot.selected { border-color:#fff; box-shadow:0 0 0 3rpx #405b45; }.form-actions,.detail-actions { display:flex; gap:18rpx; }.button { flex:1; border-radius:14rpx; font-size:28rpx; line-height:86rpx; height:86rpx; }.primary { background:#315d43; color:#fff; }.ghost { background:#e9eee7; color:#426047; }
.detail-header { display:flex; justify-content:space-between; align-items:center; }.close { font-size:46rpx; color:#829082; padding:0 10rpx; }.detail-title { font-size:45rpx; font-weight:700; margin:28rpx 0; }.detail-stats { display:flex; background:#f0f3ed; padding:25rpx 10rpx; border-radius:18rpx; }.detail-stats view { flex:1; text-align:center; border-right:1rpx solid #dce3d9; }.detail-stats view:last-child { border:0; }.detail-stats text { display:block; font-size:39rpx; font-family:Georgia,serif; }.detail-stats small { color:#718071; font-size:20rpx; }.detail-progress { margin:27rpx 0; }.detail-actions { margin-bottom:37rpx; }.record-title { font-size:28rpx; font-weight:700; margin-bottom:14rpx; }.record { display:flex; justify-content:space-between; padding:20rpx 8rpx; border-bottom:1rpx solid #e7ece4; font-size:25rpx; }.record text:last-child { color:#849084; font-size:21rpx; }.no-record { color:#95a095; text-align:center; padding:33rpx; font-size:23rpx; }.delete-link { text-align:center; color:#bb695b; font-size:24rpx; padding:33rpx 0 0; }
/* 统一字体与辅助文字字号 */
.title,.date-day,.summary-number,.detail-stats text { font-family:inherit !important; }
.eyebrow,.date-badge,.section-label,.summary-unit,.summary-caption,.reminder-head text:last-child,.due-text,.course-type,.course-bottom,.toolbar-title text,.filter,.empty-text,.nav-item,.form-item text,.color-picker > text,.detail-stats small,.record text:last-child,.no-record,.delete-link { font-size:24rpx !important; }
